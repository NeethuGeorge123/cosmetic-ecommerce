}

// Accept/Reject Item Return Buttons
document.addEventListener("DOMContentLoaded", function() {
  // Accept Item Return Button
  document.querySelectorAll('.returnBtnAccept').forEach(btn => {
    btn.addEventListener('click', async function() {
      const orderId = this.dataset.orderid;
      const itemId = this.dataset.itemid;
      
      const result = await Swal.fire({
        title: 'Approve Item Return?',
        text: "This will allow the return process to begin",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, approve it!'
      });

      if (result.isConfirmed) {
        try {
          const response = await fetch('/admin/handleItemReturn', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              orderId: orderId,
              itemId: itemId,
              action: 'approved'
            }),
          });

          const data = await response.json();
          
          if (data.success) {
            await Swal.fire({
              icon: 'success',
              title: 'Approved!',
              text: data.message,
              timer: 2000
            });
            location.reload();
          } else {
            throw new Error(data.message);
          }
        } catch (error) {
          await Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: error.message || 'Failed to approve return'
          });
        }
      }
    });
  });

  // Reject Item Return Button
  document.querySelectorAll('.returnBtnReject').forEach(btn => {
    btn.addEventListener('click', async function() {
      const orderId = this.dataset.orderid;
      const itemId = this.dataset.itemid;
      
      const { value: formValues } = await Swal.fire({
        title: 'Reject Item Return',
        html:
          '<select id="swal-category" class="swal2-select" style="width: 100%; padding: 10px; margin-bottom: 10px; border: 1px solid #d1d5db; border-radius: 8px;">' +
          '<option value="">Select category</option>' +
          '<option value="Invalid reason">Invalid reason</option>' +
          '<option value="Outside return window">Outside return window</option>' +
          '<option value="Product condition">Product condition</option>' +
          '<option value="Policy violation">Policy violation</option>' +
          '<option value="Other">Other</option>' +
          '</select>' +
          '<textarea id="swal-message" class="swal2-textarea" placeholder="Rejection reason" style="width: 100%; padding: 10px; border: 1px solid #d1d5db; border-radius: 8px;"></textarea>',
        focusConfirm: false,
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Submit',
        preConfirm: () => {
          const category = document.getElementById('swal-category').value;
          const message = document.getElementById('swal-message').value;
          
          if (!category || !message) {
            Swal.showValidationMessage('Please fill both fields');
            return false;
          }
          
          return { category, message };
        }
      });

      if (formValues) {
        try {
          const response = await fetch('/admin/handleItemReturn', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              orderId: orderId,
              itemId: itemId,
              action: 'rejected',
              category: formValues.category,
              message: formValues.message
            }),
          });

          const data = await response.json();
          
          if (data.success) {
            await Swal.fire({
              icon: 'success',
              title: 'Rejected!',
              text: data.message,
              timer: 2000
            });
            location.reload();
          } else {
            throw new Error(data.message);
          }
        } catch (error) {
          await Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: error.message || 'Failed to reject return'
          });
        }
      }
    });
  });
});

// Update Item Return Status
async function updateItemReturnStatus(orderId, itemId) {
  const { value: status } = await Swal.fire({
    title: 'Update Item Return Status',
    input: 'select',
    inputOptions: {
      'returning': 'Returning (In Transit)',
      'returned': 'Returned (Refund Now)'
    },
    inputPlaceholder: 'Select status',
    showCancelButton: true,
    confirmButtonColor: '#3b82f6',
    cancelButtonColor: '#6b7280',
    inputValidator: (value) => {
      if (!value) {
        return 'You need to select a status!';
      }
    }
  });

  if (status) {
    try {
      const response = await fetch('/admin/updateItemReturnStatus', {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          orderId: orderId,
          itemId: itemId,
          status: status
        }),
      });

      const data = await response.json();
      
      if (data.success) {
        await Swal.fire({
          icon: 'success',
          title: 'Success!',
          html: data.refundAmount > 0 
            ? `Status updated!<br><strong>₹${data.refundAmount} refunded to wallet</strong>` 
            : 'Status updated successfully',
          timer: 2500
        });
        location.reload();
      } else {
        throw new Error(data.message);
      }
    } catch (error) {
      await Swal.fire({
        icon: 'error',
        title: 'Error!',
        text: error.message || 'Failed to update status'
      });
    }
  }
}
</script>