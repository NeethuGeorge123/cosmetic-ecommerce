<div class="container-fluid mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Order Details - #<%= order.orderId %></h5>
        </div>
        <div class="card-body">
            <!-- Order Info -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <h6>Customer Information</h6>
                    <p><strong>Name:</strong> <%= order.userId.name %></p>
                    <p><strong>Email:</strong> <%= order.userId.email %></p>
                </div>
                <div class="col-md-6">
                    <h6>Order Information</h6>
                    <p><strong>Order Date:</strong> <%= new Date(order.createdOn).toLocaleDateString() %></p>
                    <p><strong>Status:</strong> <span class="badge bg-<%= order.status === 'delivered' ? 'success' : order.status === 'returned' ? 'secondary' : order.status === 'cancelled' ? 'danger' : 'warning' %>"><%= order.status %></span></p>
                    <p><strong>Total Amount:</strong> ₹<%= order.finalAmount %></p>
                </div>
            </div>

            <!-- Order Items -->
            <h6>Ordered Items</h6>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Total</th>
                            <th>Cancellation Status</th>
                            <th>Return Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.orderedItems.forEach(item => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="/Uploads/re-image/<%= item.product.productImage[0] %>" 
                                         alt="<%= item.product.productName %>" 
                                         style="width: 50px; height: 50px; object-fit: cover; margin-right: 10px;"
                                         onerror="this.src='/placeholder-image.jpg';">  <!-- ✅ NEW: Fallback for missing images -->
                                    <div>
                                        <strong><%= item.product.productName %></strong><br>
                                        <small class="text-muted"><%= item.product.brand %></small>
                                    </div>
                                </div>
                            </td>
                            <td><%= item.quantity %></td>
                            <td>₹<%= item.price %></td>
                            <td>₹<%= item.price * item.quantity %></td>
                            <td>
                                <% if (item.cancellationStatus === 'cancelled') { %>
                                    <span class="badge bg-danger">Cancelled</span>
                                    <% if (item.cancellationReason) { %>
                                        <br><small class="text-muted"><%= item.cancellationReason %></small>
                                    <% } %>
                                <% } else { %>
                                    <span class="badge bg-success">Active</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (item.returnStatus === 'none' || !item.returnStatus) { %>
                                    <span class="badge bg-secondary">No Return</span>
                                <% } else if (item.returnStatus === 'requested') { %>
                                    <span class="badge bg-warning text-dark">Return Requested</span>  <!-- ✅ FIXED: text-dark for visibility -->
                                    <% if (item.returnReason) { %>
                                        <br><small class="text-muted"><strong>Reason:</strong> <%= item.returnReason %></small>
                                    <% } %>
                                <% } else if (item.returnStatus === 'approved') { %>
                                    <span class="badge bg-success">Return Approved</span>
                                <% } else if (item.returnStatus === 'rejected') { %>
                                    <span class="badge bg-danger">Return Rejected</span>
                                    <% if (item.itemRejectionCategory || item.itemRejectionReason) { %>  <!-- ✅ FIXED: Prefixed fields -->
                                        <br><small class="text-muted">
                                            <strong><%= item.itemRejectionCategory %>:</strong> <%= item.itemRejectionReason %>
                                        </small>
                                    <% } %>
                                <% } else if (item.returnStatus === 'returning') { %>
                                    <span class="badge bg-info text-white">Returning</span>  <!-- ✅ FIXED: text-white -->
                                <% } else if (item.returnStatus === 'returned') { %>
                                    <span class="badge bg-dark text-white">Returned</span>  <!-- ✅ FIXED: text-white -->
                                <% } %>
                            </td>
                            <td>
                                <!-- Return Action Buttons -->
                                <% if (item.returnStatus === 'requested') { %>
                                    <button onclick="handleItemReturn('approved', '<%= order._id %>', '<%= item._id %>')"  <!-- ✅ FIXED: Use item._id (not product._id) for consistency -->
                                            class="btn btn-success btn-sm mb-1" data-item-id="<%= item._id %>">
                                        <i class="fas fa-check me-1"></i>Approve
                                    </button>
                                    <button onclick="showItemRejectModal('<%= order._id %>', '<%= item._id %>')"  <!-- ✅ FIXED: item._id -->
                                            class="btn btn-danger btn-sm mb-1" data-item-id="<%= item._id %>">
                                        <i class="fas fa-times me-1"></i>Reject
                                    </button>
                                <% } else if (item.returnStatus === 'approved') { %>
                                    <button onclick="updateItemReturnStatus('<%= order._id %>', '<%= item._id %>')"  <!-- ✅ FIXED: item._id -->
                                            class="btn btn-info btn-sm" data-item-id="<%= item._id %>">
                                        <i class="fas fa-truck me-1"></i>Update Status
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Item Rejection Modal -->
<div class="modal fade" id="rejectItemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reject Item Return Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Selected Item</label>
                    <input type="text" class="form-control" id="selectedItemDisplay" readonly placeholder="Item name will appear here">
                </div>
                <div class="mb-3">
                    <label class="form-label">Rejection Category</label>
                    <select class="form-select" id="itemRejectionCategory" required>
                        <option value="">Select a category</option>
                        <option value="Invalid reason">Invalid reason</option>
                        <option value="Outside return window">Outside return window</option>
                        <option value="Product condition">Product condition issues</option>
                        <option value="Policy violation">Policy violation</option>
                        <option value="Missing items">Missing items/accessories</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Detailed Explanation</label>
                    <textarea class="form-control" id="itemRejectionReason" rows="3" 
                              placeholder="Please provide a detailed explanation..." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="submitItemRejectionBtn" onclick="submitItemRejection()" disabled>Submit</button>  <!-- ✅ NEW: Disable until valid -->
            </div>
        </div>
    </div>
</div>

<script>
let currentItemOrderId = null;
let currentItemId = null;
let currentItemName = '';  // ✅ NEW: For display

// ✅ UPDATED: handleItemReturn (Add credentials, try-catch for JSON, use item._id)
async function handleItemReturn(action, orderId, itemId) {
    if (action === 'approved') {
        const result = await Swal.fire({
            title: 'Approve Item Return?',
            text: "The item will be refunded to customer's wallet and stock restored.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, approve it!'
        });

        if (result.isConfirmed) {
            try {
                const response = await fetch('/admin/handleItemReturn', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId, itemId, action: 'approved' }),
                    credentials: 'include'  // ✅ ADD: For session auth
                });

                let data;
                try {
                    data = await response.json();  // ✅ IMPROVED: Wrapped parse
                } catch (parseErr) {
                    console.error('JSON Parse Error:', parseErr);
                    throw new Error('Invalid server response');
                }
                
                if (data.success) {
                    Swal.fire(
                        'Approved!',
                        `Item return approved. ₹${data.refundAmount || 0} refunded to wallet.`,
                        'success'
                    ).then(() => location.reload());
                } else {
                    throw new Error(data.message || 'Approval failed');
                }
            } catch (error) {
                console.error('Approve Error:', error);
                Swal.fire('Error!', error.message || 'Failed to approve return', 'error');
            }
        }
    }
}

// ✅ UPDATED: showItemRejectModal (Set name, clear fields, enable submit on input)
function showItemRejectModal(orderId, itemId) {
    currentItemOrderId = orderId;
    currentItemId = itemId;
    
    // Fetch item name from row (or pass as param; here via querySelector for demo)
    const row = document.querySelector(`button[data-item-id="${itemId}"]`)?.closest('tr');
    const itemName = row?.querySelector('strong')?.textContent || 'Selected Item';
    currentItemName = itemName;
    document.getElementById('selectedItemDisplay').value = itemName;
    
    // Clear and reset modal
    document.getElementById('itemRejectionCategory').value = '';
    document.getElementById('itemRejectionReason').value = '';
    document.getElementById('submitItemRejectionBtn').disabled = true;
    
    const modal = new bootstrap.Modal(document.getElementById('rejectItemModal'));
    modal.show();
    
    // ✅ NEW: Enable submit on input change
    const categorySelect = document.getElementById('itemRejectionCategory');
    const reasonTextarea = document.getElementById('itemRejectionReason');
    const submitBtn = document.getElementById('submitItemRejectionBtn');
    
    const enableSubmit = () => submitBtn.disabled = !(categorySelect.value && reasonTextarea.value.trim());
    categorySelect.addEventListener('change', enableSubmit);
    reasonTextarea.addEventListener('input', enableSubmit);
}

// ✅ UPDATED: submitItemRejection (Add credentials, validation, try-catch)
async function submitItemRejection() {
    const category = document.getElementById('itemRejectionCategory').value;
    const message = document.getElementById('itemRejectionReason').value.trim();
    
    if (!category || !message) {
        Swal.fire({ icon: 'warning', title: 'Incomplete', text: 'Please select category and provide explanation' });
        return;
    }

    try {
        const response = await fetch('/admin/handleItemReturn', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                orderId: currentItemOrderId,
                itemId: currentItemId,
                action: 'rejected',
                category,
                message
            }),
            credentials: 'include'  // ✅ ADD
        });

        let data;
        try {
            data = await response.json();
        } catch (parseErr) {
            console.error('JSON Parse Error:', parseErr);
            throw new Error('Invalid server response');
        }
        
        if (data.success) {
            const modal = bootstrap.Modal.getInstance(document.getElementById('rejectItemModal'));
            modal.hide();
            Swal.fire('Rejected!', 'Item return request rejected.', 'success')
                .then(() => location.reload());
        } else {
            throw new Error(data.message || 'Rejection failed');
        }
    } catch (error) {
        console.error('Rejection Error:', error);
        Swal.fire('Error!', error.message || 'Failed to reject return', 'error');
    }
}

// ✅ UPDATED: updateItemReturnStatus (Add credentials, use item._id)
async function updateItemReturnStatus(orderId, itemId) {
    const { value: status } = await Swal.fire({
        title: 'Update Item Return Status',
        input: 'select',
        inputOptions: {
            'returning': 'Returning',
            'returned': 'Returned'
        },
        inputPlaceholder: 'Select status',
        showCancelButton: true,
        inputValidator: (value) => !value ? 'You need to select a status!' : null
    });

    if (status) {
        try {
            const response = await fetch('/admin/updateItemReturnStatus', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId, itemId, status }),
                credentials: 'include'  // ✅ ADD
            });

            let data;
            try {
                data = await response.json();
            } catch (parseErr) {
                console.error('JSON Parse Error:', parseErr);
                throw new Error('Invalid server response');
            }
            
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: `Item return status updated to ${status}`,
                    timer: 1500
                });
                location.reload();
            } else {
                throw new Error(data.message || 'Update failed');
            }
        } catch (error) {
            console.error('Status Update Error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: error.message || 'Failed to update status'
            });
        }
    }
}
</script>  