    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Slick Carousel JS -->
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    
    <!-- Elevate Zoom JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/elevatezoom/3.0.8/jquery.elevatezoom.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
      $(document).ready(function(){
          // Initialize product slider
          $('.product-image-slider').slick({
              slidesToShow: 1,
              slidesToScroll: 1,
              arrows: true,
              fade: true,
              asNavFor: '.slider-nav-thumbnails',
              responsive: [
                  {
                      breakpoint: 768,
                      settings: {
                          arrows: false,
                      }
                  }
              ]
          });
          
          // Initialize thumbnail navigation
          $('.slider-nav-thumbnails').slick({
              slidesToShow: 4,
              slidesToScroll: 1,
              asNavFor: '.product-image-slider',
              dots: false,
              focusOnSelect: true,
              prevArrow: '<button type="button" class="slick-prev"><i class="fas fa-chevron-left"></i></button>',
              nextArrow: '<button type="button" class="slick-next"><i class="fas fa-chevron-right"></i></button>',
              responsive: [
                  {
                      breakpoint: 768,
                      settings: {
                          slidesToShow: 4,
                      }
                  },
                  {
                      breakpoint: 576,
                      settings: {
                          slidesToShow: 3,
                      }
                  }
              ]
          });
          
          // Initialize Elevate Zoom - FIXED VERSION
          // NEW CODE - PASTE THIS INSTEAD
          function initZoom() {
    $('.zoomContainer').remove();
    
    // ✅ Replace ez.destroy() with this
    $('.zoom-img').each(function() {
        $(this).removeData('elevateZoom');
        $(this).off('mouseenter mouseleave mousemove');
    });

    var $currentImg = $('.product-image-slider .slick-current .zoom-img');
    
    if ($currentImg.length === 0) {
        $currentImg = $('.zoom-img').first();
    }

    if ($(window).width() > 767) {
        $currentImg.elevateZoom({
            zoomType: "lens",
            lensShape: "round",
            lensSize: 200,
            cursor: "crosshair",
            responsive: true,
            zoomWindowFadeIn: 500,
            zoomWindowFadeOut: 500
        });
    } else {
        $currentImg.elevateZoom({
            zoomType: "inner",
            cursor: "crosshair",
            responsive: true
        });
    }
}

// Initialize zoom after slider is fully loaded
setTimeout(function() {
    initZoom();
}, 500);

// Reinitialize zoom on window resize (with debouncing)
var resizeTimer;
$(window).resize(function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
        initZoom();
    }, 250);
});

// Reinitialize zoom when slider changes
$('.product-image-slider').on('afterChange', function(event, slick, currentSlide) {
    console.log('=== Slide Changed ===');
    console.log('Current slide index:', currentSlide);
    
    setTimeout(function() {
        // ✅ Remove zoom containers (no destroy needed)
        $('.zoomContainer').remove();
        
        // ✅ Remove elevateZoom data manually instead of destroy()
        $('.zoom-img').each(function() {
            $(this).removeData('elevateZoom');
            $(this).off('mouseenter mouseleave mousemove');
        });

        var $currentImg = $('.product-image-slider .slick-current img.zoom-img');
        console.log('Found current img elements:', $currentImg.length);
        console.log('Current img src:', $currentImg.attr('src'));

        var currentSrc = $currentImg.attr('src');
        $currentImg.attr('data-zoom-image', currentSrc);

        if ($(window).width() > 767) {
            $currentImg.elevateZoom({
                zoomType: "lens",
                lensShape: "round",
                lensSize: 200,
                cursor: "crosshair",
                responsive: true,
                zoomWindowFadeIn: 500,
                zoomWindowFadeOut: 500
            });
        } else {
            $currentImg.elevateZoom({
                zoomType: "inner",
                cursor: "crosshair",
                responsive: true
            });
        }
    }, 200);
});
          
          // Quantity buttons
          $('.qty-up').on('click', function(e) {
              e.preventDefault();
              var qtyVal = parseInt($('#quantity').text());
              $('#quantity').text(qtyVal + 1);
          });
          
          $('.qty-down').on('click', function(e) {
              e.preventDefault();
              var qtyVal = parseInt($('#quantity').text());
              if (qtyVal > 1) {
                  $('#quantity').text(qtyVal - 1);
              }
          });
      });
  
  
      function addToWishlist(productId){
          $.ajax({
              url:'/addToWishlist',
              method:'POST',
              data:{productId:productId},
              success:(response)=>{
                  if(response.status){
                      Swal.fire({
                          title:'Added to wishlist',
                          text:'The product has been added to your wishlist',
                          icon:'success',
                          timer:2000,
                          showConfirmButton: false
                      });
                  }else{
                      Swal.fire({
                          title:'Warning',
                          text:response.message,
                          icon:'warning',
                          timer:2000,
                          showConfirmButton: false
                      })
                  }
              },
              error:(error)=>{
                  Swal.fire({
                      title:'Error',
                      text:'There was an error adding the product to your wishlist',
                      icon:'error',
                      timer:2000,
                      showConfirmButton: false
                  })
              }
          })
      }
  
      function addToCart(productId){
          $.ajax({
              url:'/cart',
              method:'POST',
              data:{productId:productId},
              success:(response)=>{
                  if(response.status){
                      $('#cart-count').text(response.count);
                      Swal.fire({
                          title:'Added to cart',
                          text:'The product has been added to your cart',
                          icon:'success',
                          timer:2000,
                          showConfirmButton: false
                      });
                  }else{
                      Swal.fire({
                          title:'Already in cart',
                          text:response.message,
                          icon:'info',
                          timer:2000,
                          showConfirmButton: false
                      })
                  }
              },
              error:(error)=>{
                  Swal.fire({
                      title:'Error',
                      text:'There was an error adding the product to your cart',
                      icon:'error',
                      timer:2000,
                      showConfirmButton: false
                  })
              }
          })
      }
  </script>
    
    
</body>
</html>