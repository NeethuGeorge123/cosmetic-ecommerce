<%- include("../../views/partials/user/header") %>
<%- include("../../views/partials/user/header1") %>

<style>
  /* Scoped to .forgot-page so nothing leaks into the navbar or footer */
  .forgot-page {
    background-color: #f3f4f6;
    padding: 40px 16px;
    min-height: 70vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .forgot-page .forgot-card {
    background: #fff;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    width: 100%;
    max-width: 380px;
  }
  .forgot-page h2 { text-align: center; margin-bottom: 20px; }
  .forgot-page input[type="email"] {
    width: 100%;
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
  }
  .forgot-page .error { color: red; font-size: 0.9rem; margin-bottom: 10px; min-height: 20px; }
  .forgot-page .btn-verify {
    background-color: #10b981;
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: 10px;
    font-weight: bold;
  }
  .forgot-page .btn-verify:hover { background-color: #059669; color: #fff; }

  .forgot-page .btn-cancel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #d4e9d2;
    color: #2f4f4f;
    border: 2px solid #d4e9d2;
    padding: 10px;
    font-weight: 600;
    border-radius: 5px;
    text-decoration: none;
    transition: background-color .2s, border-color .2s;
  }
  .forgot-page .btn-cancel:hover { background: #bfdcbc; border-color: #bfdcbc; color: #2f4f4f; }
  .forgot-page .btn-cancel:focus-visible { outline: 3px solid rgba(47, 79, 79, .35); outline-offset: 2px; }
</style>

<section class="forgot-page">
  <div class="forgot-card">
    <h2>Forgot Password</h2>

    <% if (locals.message && message) { %>
      <div class="error text-center mb-3"><%= message %></div>
    <% } %>

    <form method="POST" id="forgotForm" action="/forgot-email-valid" onsubmit="return validateLoginForm()" novalidate>
      <input type="email" id="email" placeholder="Enter your email" name="email" autocomplete="email">
      <div class="error" id="errorMsg"></div>

      <div class="d-flex gap-2">
        <a href="/login" class="btn btn-cancel w-50">Back to login</a>
        <button type="submit" class="btn btn-verify w-50">Verify</button>
      </div>
    </form>
  </div>
</section>

<script>
  function validateLoginForm() {
    const email = document.getElementById('email').value.trim();
    const errorMsg = document.getElementById('errorMsg');
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!email) {
      errorMsg.textContent = "Email is required.";
      return false;
    } else if (!emailRegex.test(email)) {
      errorMsg.textContent = "Please enter a valid email address.";
      return false;
    }
    errorMsg.textContent = "";
    return true;
  }
</script>

<%- include("../../views/partials/user/footer") %>
