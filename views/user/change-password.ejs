<%- include("../../views/partials/user/header") %>
<%- include("../../views/partials/user/header1") %>
<style>
  body { background:#f8f9fa; font-family:'Segoe UI',Tahoma,sans-serif; }
  .content-main { min-height:80vh; display:flex; align-items:center; justify-content:center; padding:20px; }
  .card-login { max-width:500px; width:100%; border:none; border-radius:15px; box-shadow:0 10px 30px rgba(0,0,0,.1); background:#fff; }
  .card-body { padding:3rem 2.5rem; }
  .card-title { text-align:center; font-weight:600; margin-bottom:2rem; }
  .form-control { border:2px solid #e9ecef; border-radius:10px; padding:14px 18px; }
  .form-control:focus { border-color:#ffb3ba; box-shadow:0 0 0 .2rem rgba(255,179,186,.25); }
  .btn-primary { background:#ffb3ba; border-color:#ffb3ba; color:#333; font-weight:600; padding:14px; border-radius:10px; }
  .btn-primary:hover { background:#ff9aa1; border-color:#ff9aa1; color:#333; }
  .error-message { color:#dc3545; font-size:14px; min-height:20px; margin-top:6px; }
  .btn-cancel {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #2f4f4f;
  color: #fff;
  border: 2px solid #dee2e6;
  font-weight: 600;
  text-decoration: none;
  transition: background-color .2s, border-color .2s, color .2s;
}
.btn-cancel:hover {
  background: #f1f3f5;
  border-color: #adb5bd;
  color: #343a40;
}
.btn-cancel:focus-visible {
  outline: 3px solid rgba(108, 117, 125, .35);
  outline-offset: 2px;
}
</style>

<section class="content-main">
  <div class="card card-login">
    <div class="card-body">
      <h4 class="card-title">Change Password</h4>
      <form id="changePasswordForm" novalidate>
        <div class="mb-3">
          <input class="form-control" type="password" id="currentPassword" placeholder="Current password" autocomplete="current-password">
        </div>
        <div class="mb-3">
          <input class="form-control" type="password" id="newPassword" placeholder="New password" autocomplete="new-password">
        </div>
        <div class="mb-3">
          <input class="form-control" type="password" id="confirmPassword" placeholder="Confirm new password" autocomplete="new-password">
        </div>
        <div class="error-message" id="formError"></div>
        <div class="d-flex gap-2 mt-2">
          <a href="/my-profile" class="btn btn-outline-secondary w-50">Cancel</a>
          <button type="submit" class="btn btn-primary w-50" id="submitBtn">Change Password</button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const PASSWORD_REGEX = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{8,}$/;
  const PASSWORD_MESSAGE = "Password must be at least 8 characters with one uppercase, one lowercase, one number and one special character (@$!%*?&)";

  document.getElementById('changePasswordForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    const errorBox = document.getElementById('formError');
    const btn = document.getElementById('submitBtn');
    errorBox.textContent = '';

    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;

    if (!currentPassword || !newPassword || !confirmPassword) {
      errorBox.textContent = 'All fields are required';
      return;
    }
    if (!PASSWORD_REGEX.test(newPassword)) {
      errorBox.textContent = PASSWORD_MESSAGE;
      return;
    }
    if (newPassword !== confirmPassword) {
      errorBox.textContent = 'Passwords do not match';
      return;
    }

    btn.disabled = true;
    try {
      const res = await fetch('/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
      });
      const data = await res.json();
      if (data.success) {
        window.location.href = data.redirect || '/';
      } else {
        errorBox.textContent = data.message || 'Something went wrong';
        btn.disabled = false;
      }
    } catch (err) {
      errorBox.textContent = 'Server error. Please try again.';
      btn.disabled = false;
    }
  });
</script>

<%- include("../../views/partials/user/footer") %>